###############################################################################
# Animation Workbench Community Portal - Umgebung
#
# Kopie davon liegt auf dem Server als /srv/aw-community/.env (chmod 600).
# Diese Datei hier ist nur die Vorlage - NIE echte Werte hier eintragen.
#
# Die drei Zufallswerte erzeugen:
#   openssl rand -base64 48
# Drei verschiedene Durchlaeufe, nicht derselbe Wert dreimal.
###############################################################################

# --- Datenbank -------------------------------------------------------------
# Nur im Docker-Netz erreichbar, trotzdem ein richtiges Passwort: wer im
# Container landet, soll nicht auch noch die Datenbank geschenkt bekommen.
DB_PASSWORD=

# --- Adresse ---------------------------------------------------------------
# Muss exakt der oeffentlichen Adresse entsprechen. Daraus baut der Server die
# Discord-Rueckkehradresse und die signierten Download-Links; steht hier etwas
# anderes, schlaegt der Login mit "redirect_uri mismatch" fehl.
PORTAL_BASE_URL=https://www.playmations.com

# --- Schluessel ------------------------------------------------------------
# HMAC fuer die signierten Download-Links. Aendern macht alle offenen Links
# ungueltig (das ist der Sinn) - die Dateien selbst bleiben.
PORTAL_DOWNLOAD_SECRET=
# HMAC fuer die IP-Pseudonyme im Protokoll. Ein ANDERER Wert: sonst macht ein
# geleakter Link-Schluessel die Pseudonyme rueckrechenbar.
# Diesen Wert nie wechseln, sonst zerfaellt die Zuordnung alter Eintraege.
PORTAL_PSEUDONYM_SECRET=

# --- Discord-Anmeldung (P1) ------------------------------------------------
# https://discord.com/developers/applications > New Application > OAuth2
#   Scope:        identify
#   Redirect URI: https://www.playmations.com/login/oauth2/code/discord
# Die Redirect-URI muss dort zeichengleich eingetragen sein.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- GitHub- und Google-Anmeldung (freiwillig) -----------------------------
# Leer lassen = der Anbieter wird nicht angeboten. Sobald mehr als einer
# eingetragen ist, fuehrt "Sign in" auf eine Auswahlseite (/signin.html).
#
# GitHub: https://github.com/settings/developers > OAuth Apps > New OAuth App
#   Homepage URL:               https://www.playmations.com
#   Authorization callback URL: https://www.playmations.com/login/oauth2/code/github
#   Keine Scopes einzustellen - das Portal fragt keine an (oeffentliches Profil).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com > APIs & Services
#   OAuth consent screen: External, Scopes nur ".../auth/userinfo.profile"
#   Credentials > Create OAuth client ID > Web application
#   Authorized redirect URI: https://www.playmations.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Moderation (P4) -------------------------------------------------------
# Komma-getrennte Discord-IDs (Zahlen, nicht Namen). Eigene ID: in Discord den
# Entwicklermodus einschalten, dann Rechtsklick auf sich selbst > ID kopieren.
# Andere Anmeldungen mit Anbieter davor: github:<id>, google:<sub>. Noetig ist
# das selten - Moderator ist das KONTO, sobald irgendeine seiner verbundenen
# Anmeldungen hier steht.
# Leer heisst: niemand kann Meldungen bearbeiten.
PORTAL_ADMIN_DISCORD_IDS=

# true = Suchmaschinen duerfen das Portal listen: robots.txt gibt frei, jede Seite
# verliert ihr noindex, /sitemap.xml antwortet. Leer/false = alles gesperrt.
PORTAL_SEARCH_INDEXING=false

# --- Alarme (P3) -----------------------------------------------------------
# Meldungen und Takedowns duerfen nie unbemerkt liegen bleiben, deshalb zwei
# Kanaele. Webhook eines eigenen Discord-Kanals - NICHT der Feedback-Webhook,
# sonst mischen sich Bugreports und Rechtsmeldungen.
PORTAL_ALERT_WEBHOOK=
# Zweiter Kanal per Mail. Leer lassen faellt still auf nur-Discord zurueck.
PORTAL_ALERT_MAIL_TO=
PORTAL_ALERT_MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# --- Fassung ---------------------------------------------------------------
# Leer = :main, also der letzte Stand von main. Fuer einen Rueckfall eine
# feste Marke eintragen, z. B. main-49061b8 (docker compose up -d).
TAG=
